DATABASE_URL=postgresql://postgres:password@localhost:5432/fudo_plus
SEED_DEMO_PRODUCTS=false
ADMIN_USERNAME=negocio
# Generar con: python -m app.auth hash-password
ADMIN_PASSWORD_HASH=
# Generar con: python -m app.auth session-secret
SESSION_SECRET=
# Google OAuth: credenciales OAuth de tipo "Aplicación web" en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://127.0.0.1:8000/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# Único correo autorizado para administrar el negocio.
ADMIN_GOOGLE_EMAIL=
